/*
 * Secrets template.
 * Copy this file to secrets.h and fill in your values.
 * secrets.h is gitignored and will not be committed.
 */

#ifndef SECRETS_H
#define SECRETS_H

// --- WiFi -------------------------------------------------------------------
// First network to try.
#define WIFI_SSID     "YourWiFiName"
#define WIFI_PASSWORD "YourWiFiPassword"

// Optional extra networks (for example home now, the fridge site later).
// Remove the two slashes to enable. The device tries each in turn.
// #define WIFI_SSID_2     "SecondNetwork"
// #define WIFI_PASSWORD_2 "SecondPassword"
// #define WIFI_SSID_3     "ThirdNetwork"
// #define WIFI_PASSWORD_3 "ThirdPassword"

// --- Server -----------------------------------------------------------------
// Host name only (no https://, no path).
#define SERVER_HOST   "hollygrovenola.org"

// Name of this device as the server knows it. The board on the bench is
// "bench-01" (kept out of public numbers); only the unit at the fridge is
// "fridge-01". Each id has its own key on the server.
#define DEVICE_ID     "bench-01"

// Shared secret sent in the X-Device-Key header. Must match the server.
#define DEVICE_KEY    "replace-with-the-device-key"

// --- Cellular (Walter board only) --------------------------------------------
// APN of the SIM card's data plan. Leave empty ("") to let the network pick.
#define CELL_APN      ""

#endif // SECRETS_H
