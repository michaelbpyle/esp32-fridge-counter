# Copy to /opt/hollygrove/fridge/fridge.env on the VM, fill in, then:
#   chmod 600 /opt/hollygrove/fridge/fridge.env
# Never commit the real file.  No quotes around values.

# One entry per device: <device_id>:<key>, comma separated.  The key goes in
# the device firmware as the X-Device-Key header.  Make a key with:
#   docker exec hollygrove-fridge python -m app.cli genkey
FRIDGE_DEVICE_KEYS=fridge-01:REPLACE_WITH_GENERATED_KEY,bench-01:REPLACE_WITH_ANOTHER_KEY

# Devices stored but left out of every public number (unless ?device=<id>).
FRIDGE_TEST_DEVICES=bench-01

# Optional overrides (defaults shown).
# FRIDGE_TZ=America/Chicago
# FRIDGE_MIN_OPEN_MS=1000
# FRIDGE_ONLINE_WINDOW_S=2400
# FRIDGE_PUBLISH_GRANULARITY_S=3600
# FRIDGE_INGEST_PER_MIN=120
# FRIDGE_AUTH_FAIL_PER_MIN=20
